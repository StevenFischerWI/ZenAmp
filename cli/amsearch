#!/usr/bin/env python3
"""amsearch — search the Apple Music catalog from the terminal.

Type to search songs, albums and artists; Enter opens the selection in the
Music app (press play there — ZenAmp picks it up from Music as usual).

    amsearch                 interactive search
    amsearch tycho awake     interactive, starting with a query
    amsearch -l tycho        print results and exit (-t song|album|artist)

Uses Apple's public iTunes Search API: no account or key, but it allows
roughly 20 requests a minute, so searches fire after a short typing pause.
"""

import argparse
import curses
import json
import locale
import subprocess
import sys
import threading
import time
import unicodedata
import urllib.error
import urllib.parse
import urllib.request

API = "https://itunes.apple.com/search"
DEBOUNCE = 0.4  # seconds of no typing before a search fires
MODES = [
    ("All", "musicArtist,album,song"),
    ("Songs", "song"),
    ("Albums", "album"),
    ("Artists", "musicArtist"),
]
KIND_MARK = {"song": "♪", "album": "◉", "artist": "★"}


def default_country():
    """Storefront from the system region (en_US -> us), falling back to us."""
    try:
        loc = subprocess.run(["defaults", "read", "-g", "AppleLocale"],
                             capture_output=True, text=True, timeout=2).stdout.strip()
        region = loc.split("@")[0].split("_")[1]
        if len(region) == 2:
            return region.lower()
    except Exception:
        pass
    return "us"


def search(term, entity, country, limit=50):
    """Returns (results, error). Results are dicts with kind/name/artist/album/extra/url."""
    query = urllib.parse.urlencode({
        "term": term, "media": "music", "entity": entity,
        "country": country, "limit": limit,
    })
    try:
        with urllib.request.urlopen(f"{API}?{query}", timeout=10) as resp:
            data = json.load(resp)
    except urllib.error.HTTPError as e:
        if e.code in (403, 429):
            return [], "Apple's rate limit hit — wait a few seconds and keep typing"
        return [], f"Search failed: HTTP {e.code}"
    except Exception as e:
        return [], f"Search failed: {e}"
    return [r for r in map(normalize, data.get("results", [])) if r], None


def normalize(r):
    wrapper = r.get("wrapperType")
    if wrapper == "track" and r.get("kind") == "song":
        ms = r.get("trackTimeMillis") or 0
        return {
            "kind": "song",
            "name": r.get("trackName", ""),
            "artist": r.get("artistName", ""),
            "album": r.get("collectionName", ""),
            "extra": f"{ms // 60000}:{ms // 1000 % 60:02d}" if ms else "",
            "url": r.get("trackViewUrl"),
        }
    if wrapper == "collection":
        year = (r.get("releaseDate") or "")[:4]
        count = r.get("trackCount")
        return {
            "kind": "album",
            "name": r.get("collectionName", ""),
            "artist": r.get("artistName", ""),
            "album": "",
            "extra": " · ".join(x for x in [year, f"{count} track{'s' if count != 1 else ''}" if count else ""] if x),
            "url": r.get("collectionViewUrl"),
        }
    if wrapper == "artist":
        return {
            "kind": "artist",
            "name": r.get("artistName", ""),
            "artist": "",
            "album": "",
            "extra": r.get("primaryGenreName", ""),
            "url": r.get("artistLinkUrl"),
        }
    return None


def open_in_music(url):
    """music:// opens the page in the Music app instead of the browser."""
    if not url:
        return False
    url = url.replace("https://music.apple.com", "music://music.apple.com", 1)
    return subprocess.run(["open", url], capture_output=True).returncode == 0


# --- text fitting (CJK and emoji take two columns) ---

def cell_width(s):
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in s)


def fit(s, width):
    """Truncate with an ellipsis and pad to exactly `width` columns."""
    if width <= 0:
        return ""
    if cell_width(s) <= width:
        return s + " " * (width - cell_width(s))
    out, used = "", 0
    for c in s:
        w = cell_width(c)
        if used + w > width - 1:
            break
        out += c
        used += w
    return out + "…" + " " * (width - used - 1)


def format_row(r, width):
    """Mark | name | artist | album | extra, with columns sized to the terminal."""
    mark = KIND_MARK[r["kind"]] + " "
    extra_w = 14
    rest = max(0, width - 2 - extra_w - 3)
    if r["kind"] == "song":
        name_w = rest * 2 // 5
        artist_w = rest // 4
        album_w = rest - name_w - artist_w
        cols = [fit(r["name"], name_w), fit(r["artist"], artist_w), fit(r["album"], album_w)]
    elif r["kind"] == "album":
        name_w = rest * 3 // 5
        cols = [fit(r["name"], name_w), fit(r["artist"], rest - name_w)]
    else:
        cols = [fit(r["name"], rest)]
    return fit(mark + " ".join(cols) + " " + fit(r["extra"], extra_w), width)


# --- interactive UI ---

class App:
    def __init__(self, screen, query, country):
        self.screen = screen
        self.query = query
        self.country = country
        self.mode = 0
        self.results = []
        self.selected = 0
        self.top = 0
        self.status = "Type to search Apple Music"
        self.cache = {}
        self.lock = threading.Lock()
        self.last_edit = time.monotonic() if query else 0
        self.searched_key = None

    def key(self):
        return (self.query.strip().lower(), self.mode)

    def start_search(self):
        key = self.key()
        self.searched_key = key
        if not key[0]:
            self.results, self.status = [], "Type to search Apple Music"
            return
        if key in self.cache:
            self.show(key, *self.cache[key])
            return
        self.status = "Searching…"

        def work():
            results, error = search(key[0], MODES[key[1]][1], self.country)
            with self.lock:
                if not error:
                    self.cache[key] = (results, None)
                self.show(key, results, error)
        threading.Thread(target=work, daemon=True).start()

    def show(self, key, results, error):
        if key != self.key():  # a newer search has superseded this one
            return
        self.results = results
        self.selected = self.top = 0
        if error:
            self.status = error
        else:
            n = len(results)
            self.status = f"{n} result{'s' if n != 1 else ''}" if n else "No matches"

    def draw(self):
        s = self.screen
        s.erase()
        h, w = s.getmaxyx()
        if h < 5 or w < 30:
            s.addstr(0, 0, "Window too small"[: w - 1])
            s.refresh()
            return

        tabs = "  ".join(f"[{name}]" if i == self.mode else f" {name} " for i, (name, _) in enumerate(MODES))
        s.addstr(0, 0, fit(f" Apple Music  {tabs}", w - 1), curses.A_BOLD)
        prompt = " Search: "
        s.addstr(1, 0, prompt, curses.A_DIM)
        s.addstr(1, len(prompt), fit(self.query, w - len(prompt) - 1))
        s.addstr(2, 0, fit(" " + self.status, w - 1), curses.A_DIM)

        rows = h - 4
        if self.selected < self.top:
            self.top = self.selected
        elif self.selected >= self.top + rows:
            self.top = self.selected - rows + 1
        for i, r in enumerate(self.results[self.top:self.top + rows]):
            attr = curses.A_REVERSE if self.top + i == self.selected else curses.A_NORMAL
            s.addstr(3 + i, 0, format_row(r, w - 1), attr)

        help_text = " ↑↓ move  Enter open in Music  Tab type  Ctrl-U clear  Esc quit"
        s.addstr(h - 1, 0, fit(help_text, w - 1), curses.A_DIM)
        s.move(1, min(w - 1, len(prompt) + cell_width(self.query)))
        s.refresh()

    def run(self):
        curses.curs_set(1)
        curses.set_escdelay(25)
        self.screen.timeout(100)  # wake up to fire debounced searches
        if self.query:
            self.start_search()
        while True:
            with self.lock:
                if self.last_edit and time.monotonic() - self.last_edit >= DEBOUNCE \
                        and self.key() != self.searched_key:
                    self.start_search()
                self.draw()
            try:
                ch = self.read_key()
            except curses.error:
                continue  # timeout
            with self.lock:
                if self.handle(ch) is False:
                    return

    def read_key(self):
        """A key as a str, or a curses KEY_* int. Raises curses.error on timeout."""
        if hasattr(self.screen, "get_wch"):
            return self.screen.get_wch()
        # Builds of curses without wide-character support (e.g. python.org's) only
        # have getch, which yields UTF-8 one byte at a time — reassemble it.
        first = self.screen.getch()
        if first == -1:
            raise curses.error("timeout")
        if first > 255:
            return first
        needed = 1 if first >= 0xC0 else 0
        needed += 1 if first >= 0xE0 else 0
        needed += 1 if first >= 0xF0 else 0
        data = bytes([first])
        for _ in range(needed):
            nxt = self.screen.getch()
            if 0 <= nxt <= 255:
                data += bytes([nxt])
        return data.decode("utf-8", "replace")

    def handle(self, ch):
        if ch in ("\x1b", "\x03"):  # Esc, Ctrl-C
            return False
        if ch == curses.KEY_UP:
            self.selected = max(0, self.selected - 1)
        elif ch == curses.KEY_DOWN:
            self.selected = min(max(0, len(self.results) - 1), self.selected + 1)
        elif ch == curses.KEY_PPAGE:
            self.selected = max(0, self.selected - (self.screen.getmaxyx()[0] - 4))
        elif ch == curses.KEY_NPAGE:
            self.selected = min(max(0, len(self.results) - 1), self.selected + (self.screen.getmaxyx()[0] - 4))
        elif ch in ("\n", "\r", curses.KEY_ENTER):
            if self.results:
                r = self.results[self.selected]
                ok = open_in_music(r["url"])
                self.status = f"Opened in Music: {r['name']}" if ok else "Couldn't open that one"
        elif ch in ("\t", curses.KEY_BTAB):
            step = 1 if ch == "\t" else -1
            self.mode = (self.mode + step) % len(MODES)
            self.last_edit = time.monotonic() - DEBOUNCE  # search now
        elif ch in (curses.KEY_BACKSPACE, "\x7f", "\b"):
            self.query = self.query[:-1]
            self.last_edit = time.monotonic()
        elif ch == "\x15":  # Ctrl-U
            self.query = ""
            self.last_edit = time.monotonic()
        elif isinstance(ch, str) and ch.isprintable():
            self.query += ch
            self.last_edit = time.monotonic()
        elif ch == curses.KEY_RESIZE:
            pass
        return True


def main():
    parser = argparse.ArgumentParser(description="Search the Apple Music catalog; Enter opens the pick in Music.")
    parser.add_argument("query", nargs="*", help="search terms")
    parser.add_argument("-l", "--list", action="store_true", help="print results and exit")
    parser.add_argument("-t", "--type", choices=["song", "album", "artist"], help="with -l: only this type")
    parser.add_argument("-n", "--limit", type=int, default=25, help="with -l: number of results (max 200)")
    parser.add_argument("-c", "--country", default=None, help="storefront, e.g. us, gb (default: system region)")
    args = parser.parse_args()
    query = " ".join(args.query)
    country = (args.country or default_country()).lower()

    if args.list:
        if not query:
            parser.error("-l needs a query")
        entity = {"song": "song", "album": "album", "artist": "musicArtist"}.get(args.type, MODES[0][1])
        results, error = search(query, entity, country, limit=max(1, min(args.limit, 200)))
        if error:
            print(error, file=sys.stderr)
            return 1
        if not results:
            print("No matches", file=sys.stderr)
        for r in results:
            fields = [r["kind"], r["name"], r["artist"], r["album"], r["extra"], r["url"] or ""]
            print(" | ".join(f for f in fields if f))
        return 0

    if not sys.stdin.isatty() or not sys.stdout.isatty():
        parser.error("interactive mode needs a terminal; use -l to print results")
    locale.setlocale(locale.LC_ALL, "")
    curses.wrapper(lambda screen: App(screen, query, country).run())
    return 0


if __name__ == "__main__":
    sys.exit(main())
